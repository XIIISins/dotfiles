.DS_Store

# machine-local or generated; install.sh carries these across on first link
config/fish/fish_variables
config/tmux/plugins/
config/karabiner/automatic_backups/
# btop rewrites its settings on exit; only the theme is tracked
config/btop/btop.conf
# spicetify rewrites its settings (backup version, current theme) itself; only the theme is tracked
config/spicetify/config-xpui.ini
# teams init writes the profile (backend, client id, tenant) per machine; only the build script is tracked
config/teams/config.toml

# old places for machine-local settings, still read until every machine uses ~/.config/local
config/fish/config-local.fish
config/git/config.local

# fisher plugins (see fish_plugins); `fisher update` reinstalls them
config/fish/completions/fisher.fish
config/fish/completions/fzf_configure_bindings.fish
config/fish/completions/nvm.fish
config/fish/completions/tide.fish
config/fish/conf.d/_tide_init.fish
config/fish/conf.d/fzf.fish
config/fish/conf.d/nvm.fish
config/fish/functions/_fzf_configure_bindings_help.fish
config/fish/functions/_fzf_extract_var_info.fish
config/fish/functions/_fzf_preview_changed_file.fish
config/fish/functions/_fzf_preview_file.fish
config/fish/functions/_fzf_report_diff_type.fish
config/fish/functions/_fzf_report_file_type.fish
config/fish/functions/_fzf_search_directory.fish
config/fish/functions/_fzf_search_git_log.fish
config/fish/functions/_fzf_search_git_status.fish
config/fish/functions/_fzf_search_history.fish
config/fish/functions/_fzf_search_processes.fish
config/fish/functions/_fzf_search_variables.fish
config/fish/functions/_fzf_wrapper.fish
config/fish/functions/_nvm_index_update.fish
config/fish/functions/_nvm_list.fish
config/fish/functions/_nvm_version_activate.fish
config/fish/functions/_nvm_version_deactivate.fish
# glob, since tide point releases add new prompt items (e.g. _tide_item_bun)
config/fish/functions/_tide_*.fish
config/fish/functions/fish_mode_prompt.fish
config/fish/functions/fish_prompt.fish
config/fish/functions/fisher.fish
config/fish/functions/fzf_configure_bindings.fish
config/fish/functions/nvm.fish
config/fish/functions/tide
config/fish/functions/tide.fish

# Claude Code: the project settings and their hooks are shared, the rest (worktrees,
# settings.local.json) is per machine; some global gitignores exclude .claude entirely
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
