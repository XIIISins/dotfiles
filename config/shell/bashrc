# Server shell config, sourced from ~/.bashrc by install.sh. Plain bash: no plugins, no network.
case $- in *i*) ;; *) return 0 ;; esac

# history
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize

# PATH
for d in "$HOME/.local/bin" "$HOME/bin" /usr/local/bin; do
    case ":$PATH:" in *":$d:"*) ;; *) [ -d "$d" ] && PATH="$d:$PATH" ;; esac
done
export PATH

# editor
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
    alias vi=nvim vim=nvim
else
    export EDITOR=vi
fi

# aliases
alias ls='ls -p --color=auto'
alias la='ls -A'
alias ll='ls -l'
alias lla='ll -A'
alias g=git
alias grep='grep --color=auto'

# prompt: user@host in the palette blue, cwd in cyan, git branch in comment grey.
# ../palette resolves through the repo symlink, as in tmux.conf.
_shell_dir=$(dirname "${BASH_SOURCE[0]}")
if [ -r "$_shell_dir/../palette/out/tokyonight-moon.sh" ]; then
    . "$_shell_dir/../palette/out/tokyonight-moon.sh"
    _c() { printf '\\[\\e[38;2;%sm\\]' "$1"; }
    _user=$(_c "$TN_BLUE_RGB")
    [ "$(id -u)" = 0 ] && _user=$(_c "$TN_RED_RGB")
    _git_branch() {
        local b
        b=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || return 0
        printf ' (%s)' "$b"
    }
    PS1="${_user}\\u@\\h $(_c "$TN_CYAN_RGB")\\w$(_c "$TN_COMMENT_RGB")\$(_git_branch)\\[\\e[0m\\] \\\$ "
    unset -f _c
    unset _user
fi
unset _shell_dir
