// Colours are TokyoNight Moon from config/palette (blue #82aaff, magenta
// #c099ff, comment #636da6) as truecolor SGR codes, since fastfetch takes no hex.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // the stock Apple logo is six-colour rainbow; paint every band blue
    "color": { "1": "38;2;130;170;255", "2": "38;2;130;170;255", "3": "38;2;130;170;255", "4": "38;2;130;170;255", "5": "38;2;130;170;255", "6": "38;2;130;170;255" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;130;170;255", "title": "38;2;192;153;255", "separator": "38;2;99;109;166" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
