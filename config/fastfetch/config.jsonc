// Colours are TokyoNight Moon from config/palette (blue #82aaff, magenta
// #c099ff, comment #636da6) as truecolor SGR codes, since fastfetch takes no hex.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // the stock Apple logo is six-colour rainbow; paint every band blue
    "color": { "1": "38;2;130;170;255", "2": "38;2;130;170;255", "3": "38;2;130;170;255", "4": "38;2;130;170;255", "5": "38;2;130;170;255", "6": "38;2;130;170;255" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;130;170;255", "title": "38;2;192;153;255", "separator": "38;2;99;109;166" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "uptime",
    "packages",
    "shell",
    "de",
    "icons",
    // inside tmux/screen TERM_PROGRAM is the multiplexer, so ask tmux for the
    // outer terminal's values (tmux keeps them in its global environment)
    {
      "type": "command",
      "key": "Terminal",
      "text": "if [ -n \"$TMUX\" ]; then tmux show-environment -g TERM_PROGRAM 2>/dev/null | cut -d= -f2; tmux show-environment -g TERM_PROGRAM_VERSION 2>/dev/null | cut -d= -f2; else echo \"$TERM_PROGRAM\"; echo \"$TERM_PROGRAM_VERSION\"; fi | paste -sd ' ' -"
    },
    {
      "type": "command",
      "key": "Theme",
      "text": "ghostty +show-config 2>/dev/null | sed -n 's/^theme = //p'"
    },
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
