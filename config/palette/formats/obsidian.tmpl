@rem Obsidian CSS snippet: the palette, then the Obsidian variables it fills. Snippets
@rem live inside each vault and cannot import files, so this one is self-contained.
@out {palette}-obsidian.css
@head
/* Generated by palette/render from {palette}.palette. Do not edit. */
body {
@line
  --tn-{kebab}: {#hex};
@foot
}

.theme-dark {
  --color-base-00: var(--tn-bg-dark);
  --color-base-05: var(--tn-bg-dark);
  --color-base-10: var(--tn-bg);
  --color-base-20: var(--tn-bg);
  --color-base-25: var(--tn-bg-highlight);
  --color-base-30: var(--tn-fg-gutter);
  --color-base-35: var(--tn-comment);
  --color-base-40: var(--tn-comment);
  --color-base-50: var(--tn-dim);
  --color-base-60: var(--tn-fg-dark);
  --color-base-70: var(--tn-fg-dark);
  --color-base-100: var(--tn-fg);

  --color-red: var(--tn-red);
  --color-orange: var(--tn-orange);
  --color-yellow: var(--tn-yellow);
  --color-green: var(--tn-green);
  --color-cyan: var(--tn-cyan);
  --color-blue: var(--tn-blue);
  --color-purple: var(--tn-magenta);
  --color-pink: var(--tn-magenta);

  --background-primary: var(--tn-bg);
  --background-primary-alt: var(--tn-bg-dark);
  --background-secondary: var(--tn-bg-dark);
  --background-modifier-border: var(--tn-fg-gutter);
  --background-modifier-hover: var(--tn-bg-highlight);
  --text-normal: var(--tn-fg);
  --text-muted: var(--tn-fg-dark);
  --text-faint: var(--tn-comment);
  --text-selection: var(--tn-selection);
  --text-highlight-bg: var(--tn-selection);

  --accent-h: 218;
  --accent-s: 100%;
  --accent-l: 75%;
  --interactive-accent: var(--tn-blue);
  --interactive-accent-hover: var(--tn-cyan);
  --text-accent: var(--tn-blue);
  --text-accent-hover: var(--tn-cyan);
  --text-on-accent: var(--tn-bg-dark);

  --code-background: var(--tn-bg-dark);
  --code-normal: var(--tn-fg);
  --code-comment: var(--tn-comment);
  --code-keyword: var(--tn-magenta);
  --code-string: var(--tn-green);
  --code-value: var(--tn-orange);
  --code-function: var(--tn-blue);
  --code-property: var(--tn-cyan);
  --code-tag: var(--tn-red);
  --code-punctuation: var(--tn-fg-dark);
  --code-important: var(--tn-yellow);
}
