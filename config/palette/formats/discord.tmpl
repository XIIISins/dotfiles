@rem Vesktop (Vencord) theme: the palette, then the Discord variables it fills. Discord
@rem renames these now and then; both the old and the new names are set.
@out {palette}-discord.theme.css
@head
/**
 * @name TokyoNight Moon
 * @description Generated by palette/render from {palette}.palette. Do not edit.
 */
:root, .theme-dark, .theme-darker, .theme-midnight {
@line
  --tn-{kebab}: {#hex};
@foot
}

.theme-dark, .theme-darker, .theme-midnight {
  /* surfaces: server list darkest, then channel list, then chat */
  --background-base-lowest: var(--tn-black);
  --background-base-lower: var(--tn-bg-dark);
  --background-base-low: var(--tn-bg-dark);
  --background-surface-high: var(--tn-bg);
  --background-surface-higher: var(--tn-bg-highlight);
  --background-surface-highest: var(--tn-fg-gutter);
  --chat-background-default: var(--tn-bg);
  --channeltextarea-background: var(--tn-bg-highlight);
  --background-primary: var(--tn-bg);
  --background-secondary: var(--tn-bg-dark);
  --background-secondary-alt: var(--tn-bg-dark);
  --background-tertiary: var(--tn-black);
  --background-floating: var(--tn-bg-float);
  --background-accent: var(--tn-fg-gutter);
  --background-mod-subtle: var(--tn-bg-highlight);
  --background-mod-normal: var(--tn-bg-highlight);
  --background-mod-strong: var(--tn-fg-gutter);
  --background-modifier-hover: var(--tn-bg-highlight);
  --background-modifier-selected: var(--tn-selection);
  --background-modifier-active: var(--tn-selection);
  --border-subtle: var(--tn-fg-gutter);
  --border-normal: var(--tn-fg-gutter);

  /* text */
  --text-default: var(--tn-fg);
  --text-strong: var(--tn-fg);
  --text-normal: var(--tn-fg);
  --text-muted: var(--tn-fg-dark);
  --text-subtle: var(--tn-comment);
  --text-link: var(--tn-blue);
  --header-primary: var(--tn-fg);
  --header-secondary: var(--tn-fg-dark);
  --interactive-normal: var(--tn-fg-dark);
  --interactive-hover: var(--tn-fg);
  --interactive-active: var(--tn-fg);
  --interactive-muted: var(--tn-comment);
  --channels-default: var(--tn-fg-dark);

  /* accent: blurple becomes the palette blue, with dark text on it */
  --brand-500: var(--tn-blue);
  --brand-360: var(--tn-blue);
  --brand-400: var(--tn-cyan);
  --brand-560: var(--tn-blue);
  --brand-experiment: var(--tn-blue);
  --brand-experiment-560: var(--tn-blue);
  --button-filled-brand-background: var(--tn-blue);
  --button-filled-brand-text: var(--tn-bg-dark);
  --mention-foreground: var(--tn-blue);
  --mention-background: var(--tn-selection);

  /* status */
  --status-positive: var(--tn-green);
  --status-warning: var(--tn-yellow);
  --status-danger: var(--tn-red);
  --status-online: var(--tn-green);
  --status-idle: var(--tn-yellow);
  --status-dnd: var(--tn-red);
  --green-360: var(--tn-green);
  --red-400: var(--tn-red);
}
