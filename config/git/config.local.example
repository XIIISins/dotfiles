# copy to ~/.config/local/git/config (outside the repo) and fill in; included last from ./config
[user]
	name = Your Name
	email = you@example.com
	signingkey = ssh-ed25519 AAAA...

[gpg]
	format = ssh

[gpg "ssh"]
	# macOS; on Linux use /opt/1Password/op-ssh-sign
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = true

# optional: another identity for every repo below a directory (keep the trailing slash),
# e.g. personal repos on a work machine; the file holds just a [user] section
[includeIf "gitdir:~/Development/personal/"]
	path = ~/.config/local/git/personal

# optional: machine-only ignore patterns. This replaces ./ignore, so repeat its patterns there.
[core]
	excludesFile = ~/.config/local/git/ignore
